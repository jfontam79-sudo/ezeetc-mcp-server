# EZeeTC MCP Server Configuration
# Copy this to .env and fill in your values

# Port (default 3001 for dev, 8080 for Cloud Run)
PORT=3001

# Bearer token for MCP authentication (leave empty for dev)
MCP_BEARER_TOKEN=

# Google Apps Script web app URL (your deployed GAS endpoint)
GAS_URL=https://script.google.com/macros/s/AKfycbxEm4G8XQzCHfxcEQ-Kzaxew0pfIdlxfSBMpHmv0SvPaRDUBU8GQcZbdaJIHpRABwANjQ/exec

# Anthropic API key (for future Managed Agent integration)
ANTHROPIC_API_KEY=
